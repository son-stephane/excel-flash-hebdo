{# Corps du mail hebdomadaire.
   Contraintes clients mail : tableaux + styles en ligne, pas de flex/grid,
   pas de CSS externe. Les images sont referencees par leur Content-ID. #}
<html>
  <body style="margin:0;padding:0;background:#f4f4f2;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
           style="background:#f4f4f2;padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="680" cellpadding="0" cellspacing="0"
                 style="width:680px;max-width:100%;background:#ffffff;border-radius:10px;
                        border:1px solid #e8e7e3;font-family:Segoe UI,Helvetica,Arial,sans-serif;">

            <tr>
              <td style="padding:26px 30px 6px 30px;">
                <div style="font-size:20px;font-weight:600;color:#0b0b0b;">
                  Flash hebdomadaire &mdash; {{ libelle_semaine }}
                </div>
                <div style="font-size:13px;color:#7a7873;padding-top:4px;">
                  Extraction du portail du {{ date_extraction }} &middot; semaine {{ semaine }}
                </div>
              </td>
            </tr>

            {% if indicateurs %}
            <tr>
              <td style="padding:18px 30px 6px 30px;">
                <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    {% for indicateur in indicateurs %}
                    <td width="33%" style="padding:12px 14px;background:#fafaf9;
                        border:1px solid #e8e7e3;border-radius:8px;vertical-align:top;">
                      <div style="font-size:11px;color:#7a7873;text-transform:uppercase;
                                  letter-spacing:.04em;">{{ indicateur.libelle }}</div>
                      <div style="font-size:22px;font-weight:600;color:#0b0b0b;padding-top:3px;">
                        {{ indicateur.valeur }}</div>
                      {% if indicateur.variation %}
                      <div style="font-size:12px;color:{{ indicateur.couleur }};padding-top:2px;">
                        {{ indicateur.variation }}</div>
                      {% endif %}
                    </td>
                    {% if not loop.last %}<td width="12">&nbsp;</td>{% endif %}
                    {% endfor %}
                  </tr>
                </table>
              </td>
            </tr>
            {% endif %}

            {% for graphique in graphiques %}
            <tr>
              <td style="padding:20px 30px 0 30px;">
                <img src="cid:{{ graphique.cid }}" alt="{{ graphique.titre }}"
                     width="620" style="width:620px;max-width:100%;display:block;border:0;" />
              </td>
            </tr>
            {% endfor %}

            {% if alertes %}
            <tr>
              <td style="padding:22px 30px 0 30px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="background:#fdf6e8;border:1px solid #eda100;border-radius:8px;">
                  <tr>
                    <td style="padding:12px 16px;font-size:13px;color:#52514e;">
                      <strong style="color:#0b0b0b;">Points de vigilance</strong>
                      <ul style="margin:8px 0 0 18px;padding:0;">
                        {% for alerte in alertes %}
                        <li style="padding-bottom:3px;">{{ alerte }}</li>
                        {% endfor %}
                      </ul>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            {% endif %}

            <tr>
              <td style="padding:22px 30px 28px 30px;font-size:12px;color:#7a7873;
                         border-top:1px solid #e8e7e3;margin-top:20px;">
                {{ note_bas_de_page }}
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
